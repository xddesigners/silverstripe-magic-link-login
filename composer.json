{
    "name": "xddesigners/silverstripe-magic-link-login",
    "description": "Passwordless login via a unique emailed link, with an optional emailed verification code as a second factor, and per-login session scoping to specific records.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "magic-link",
        "passwordless",
        "login",
        "authentication",
        "security"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "XD\\MagicLinkLogin\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
